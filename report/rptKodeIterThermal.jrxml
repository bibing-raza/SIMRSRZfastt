	<queryString>
		<![CDATA[SELECT i.*, p.nm_pasien, pl.nm_poli, 
CONCAT(DAY(i.tgl_exp_rujukan), ' ', CASE MONTH(i.tgl_exp_rujukan) 
WHEN 1 THEN 'Januari' 
WHEN 2 THEN 'Februari' 
WHEN 3 THEN 'Maret' 
WHEN 4 THEN 'April' 
WHEN 5 THEN 'Mei' 
WHEN 6 THEN 'Juni' 
WHEN 7 THEN 'Juli' 
WHEN 8 THEN 'Agustus' 
WHEN 9 THEN 'September' 
WHEN 10 THEN 'Oktober' 
WHEN 11 THEN 'November' 
WHEN 12 THEN 'Desember' END,' ',YEAR(i.tgl_exp_rujukan)) tglExpRujukan, if(i.kunjungan='1','Pertama (1)',if(i.kunjungan='2','Kedua (2)','Ketiga (3)')) pengambilan FROM iter_obat_bpjs i 
inner join reg_periksa rp on rp.no_rawat=i.no_rawat
inner join pasien p on p.no_rkm_medis=rp.no_rkm_medis
inner join poliklinik pl on pl.kd_poli=rp.kd_poli where i.waktu_simpan='2025-07-01 09:47:04']]>
	</queryString>
