	<parameter name="jam_meninggal" class="java.lang.String"/>
	<parameter name="jam_keluar" class="java.lang.String"/>
	<parameter name="lokasiQrDpjp" class="java.lang.String"/>
	<parameter name="lokasiQrPerawat" class="java.lang.String"/>
	<parameter name="lokasiQrPetugas" class="java.lang.String"/>
	<parameter name="lokasiQrDokter" class="java.lang.String"/>
