			<staticText>
				<reportElement x="10" y="82" width="488" height="50">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Justified" verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[          Formulir ini adalah perintah dokter penanggung jawab pelayanan kepada seluruh staff klinis rumah sakit, agar tidak dilakukan resusitasi pada pasien ini bila terjadi henti jantung (bila tak ada denyut nadi) dan henti nafas (tak ada pernapasan spontan).

          Formulir ini juga memberikan perintah kepada staff medis untuk tetap melakukan intervensi atau pengobatan, atau tata laksana lainnya sebelum terjadinya henti jantung atau henti nafas.]]></text>
			</staticText>
			<staticText>
				<reportElement x="39" y="137" width="40" height="12">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<text><![CDATA[Nama]]></text>
			</staticText>
			<textField>
				<reportElement x="78" y="137" width="436" height="12"/>
				<textElement verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[": "+$P{nmpasien}+" ("+$P{jenkel}+")"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="78" y="150" width="436" height="12"/>
				<textElement verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[": "+$P{ttlPasien}+"   Umur : "+$P{umur}]]></textFieldExpression>
			</textField>
			<staticText>
