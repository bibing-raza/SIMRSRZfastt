					<font fontName="Tahoma" size="10" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[mungkin belum diprediksi. Saya menyadari bahwa ilmu kedokteran bukanlah ilmu pasti maka keberhasilan]]></text>
			</staticText>
			<staticText>
