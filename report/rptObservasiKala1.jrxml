	<queryString>
		<![CDATA[select okk.*, date_format(okk.tgl_observasi ,'%d-%m-%Y') tglObs, time_format(okk.jam_observasi,'%H:%i Wita') jamObs, 
pg.nama nmPtgs from observasi_kala1_kebidanan okk inner join pegawai pg on pg.nik=okk.nip_petugas 
WHERE okk.no_rawat ='2025/08/24/000053' ORDER BY okk.waktu_simpan]]>
	</queryString>
