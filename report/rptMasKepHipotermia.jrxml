			<staticText>
				<reportElement x="414" y="164" width="347" height="21" uuid="3b7c0b4a-c6bd-4e5f-9136-f9aa3159599f">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Identifikasi penyebab hipotermia (mis, terpapar suhu lingkungan rendah, pakaian tipis, kerusakan hipotalamus, penurunan laju metabolisme, kekurangan lemak subkutan)]]></text>
			</staticText>
			<rectangle>
				<reportElement mode="Transparent" x="400" y="164" width="11" height="11" uuid="6062243c-50a5-4e0d-b8b2-825267f425b3"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</rectangle>
			<textField>
				<reportElement x="400" y="185" width="11" height="11" uuid="4553a939-0954-42b7-a6c4-9c7563fa4695"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Tahoma" size="8"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression><![CDATA[$P{sikiMonitorTanda}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="414" y="185" width="347" height="32" uuid="748f62e8-9b43-4fd6-9c5e-6811e39e264d">
					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Top">
					<font fontName="Tahoma" size="8" isBold="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<text><![CDATA[Monitor tanda dan gejala akibat hipotermia (hipotermia ringan : takipnea, disartria, mengigil, hipertensi, diuresis ; hipotermia sedang : aritmia, hipotensi, apatis, koagulopati, refleks menurun, hipotermia berat : oliguria, refleks menghilang, edema paru, asam-basa abnormal)]]></text>
			</staticText>
			<rectangle>
				<reportElement mode="Transparent" x="400" y="185" width="11" height="11" uuid="2cad4b97-1f4c-49d3-9d97-630aa6671d4e"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</rectangle>
			<staticText>
