	<queryString>
		<![CDATA[select p.*, sp.bank, sp.no_rekening, sp.atas_nama from peserta_bpjs_bayar_denda p
inner join surat_pernyataan_bayar_denda sp on sp.no_rawat=p.no_rawat where 
p.no_rawat='2025/08/24/000051' order by p.waktu_simpan]]>
