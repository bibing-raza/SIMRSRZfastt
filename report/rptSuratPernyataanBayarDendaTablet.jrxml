				</textElement>
				<text><![CDATA[Catatan
(1) Nama
(2) NoKartu
(3) Jabatan
(4) Status
(5) Tanggungan]]></text>
			</staticText>
			<staticText>
				<reportElement x="82" y="10" width="270" height="64"/>
				<textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8" isBold="false" isItalic="true" isUnderline="false"/>
				</textElement>
				<text><![CDATA[
: Nama Peserta yang menjalani rawatinap
: Nomor yang tertera pada kartu BPJS Kesehatan (13 digit)
: Jabatan pekerjaan peserta
: Peserta/Istri/Suami/Anak/Tambahan(P/I/S/A/T)
: Nama dari penanggung pasien]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="77" width="11" height="12"/>
				<textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8" isBold="false"/>
				</textElement>
				<text><![CDATA[5.]]></text>
			</staticText>
			<staticText>
				<reportElement x="11" y="77" width="503" height="23"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8" isBold="false"/>
				</textElement>
				<text><![CDATA[Melakukan pembayaran atas selisih biaya pelayanan kesehatan berdasarkan diagnosa awal dan diagnosa akhir yang diperhitungkan bersamaan dengan pembayaran tagihan iuran bulan berikutnya melalui :]]></text>
			</staticText>
			<rectangle>
				<reportElement mode="Transparent" x="11" y="102" width="11" height="11"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</rectangle>
			<textField>
				<reportElement x="11" y="102" width="11" height="11"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" lineSpacing="Single">
					<font fontName="Tahoma" size="8"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$P{satuKali}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="26" y="102" width="210" height="12"/>
				<textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8" isBold="false"/>
				</textElement>
				<text><![CDATA[1 (satu) kali tahap pembayaran]]></text>
			</staticText>
			<staticText>
				<reportElement x="26" y="115" width="210" height="12"/>
				<textElement textAlignment="Left" verticalAlignment="Top" lineSpacing="Single">
					<font fontName="Tahoma" size="8" isBold="false"/>
				</textElement>
				<text><![CDATA[3 (tiga) kali tahap pembayaran]]></text>
			</staticText>
			<rectangle>
				<reportElement mode="Transparent" x="11" y="115" width="11" height="11"/>
				<graphicElement>
					<pen lineWidth="0.5"/>
				</graphicElement>
			</rectangle>
			<textField>
